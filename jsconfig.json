{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["matelabs/arcade.js", "matelabs/characters.js", "matelabs/missions.js", "matelabs/catalog.js", "matelabs/portal.js", "games/registry.js"]
}
